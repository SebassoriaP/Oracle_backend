<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>omi-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>omi-backend</name>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <oracle.jdbc.version>23.26.0.0.0</oracle.jdbc.version>
        <plantuml-generator.version>2.4.1</plantuml-generator.version>
        <diagrams.output.dir>${project.basedir}/docs/diagrams</diagrams.output.dir>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Oracle JDBC + wallet-related libraries bundle -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17-production</artifactId>
            <version>${oracle.jdbc.version}</version>
            <type>pom</type>
        </dependency>

        <!-- Required for ADB wallet/SSL -->
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>oraclepki</artifactId>
            <version>${oracle.jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>osdt_core</artifactId>
            <version>21.11.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>osdt_cert</artifactId>
            <version>21.11.0.0</version>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- OpenAPI Doc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Embedding library -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
            <version>1.16.1-beta26</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>diagrams</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>de.elnarion.maven</groupId>
                        <artifactId>plantuml-generator-maven-plugin</artifactId>
                        <version>${plantuml-generator.version}</version>
                        <executions>
                            <execution>
                                <id>diagram-auth</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>auth-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.auth</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.auth\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-user</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>user-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.user</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.user\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-role</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>role-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.role</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.role\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-project</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>project-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.project</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.project\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-sprint</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>sprint-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.sprint</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.sprint\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-feature</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>feature-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.feature</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.feature\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-issue</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>issue-service.puml</outputFilename>
                                    <scanPackages>
                                        <scanPackage>com.example.omi.issue</scanPackage>
                                        <scanPackage>com.example.omi</scanPackage>
                                    </scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.issue\..*|com\.example\.omi\.EmbeddingService</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-kpi</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>kpi-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.kpi</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.kpi\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-overdue</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>overdue-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.overdue</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.overdue\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-health</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>health-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.health</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.health\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                            <execution>
                                <id>diagram-config</id>
                                <phase>generate-sources</phase>
                                <goals><goal>generate</goal></goals>
                                <configuration>
                                    <outputDirectory>${diagrams.output.dir}</outputDirectory>
                                    <outputFilename>config-service.puml</outputFilename>
                                    <scanPackages><scanPackage>com.example.omi.config</scanPackage></scanPackages>
                                    <whitelistRegexp>com\.example\.omi\.config\..*</whitelistRegexp>
                                    <removeMethods>true</removeMethods>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
